# ── Credenciales de tu app en developers.mercadolibre.com.ar ──
ML_CLIENT_ID=tu_app_id_aqui
ML_CLIENT_SECRET=tu_client_secret_aqui
ML_REDIRECT_URI=https://localhost

# ── Tokens (se completan automáticamente al correr --auth) ──
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
ML_USER_ID=

# ── Reglas de repricing ──
# Estrategias disponibles: undercut_min | match_min | undercut_avg
STRATEGY=undercut_min

# % a bajar respecto al precio de referencia (solo para undercut_*)
MARGIN_PERCENT=2

# Precio mínimo y máximo en ARS (límites absolutos)
MIN_PRICE=1000
MAX_PRICE=9999999

# % mínimo de cambio para actualizar (evita micro-actualizaciones)
MIN_CHANGE_THRESHOLD=1

# ── Arbitrage finder (Amazon → MercadoLibre) ──
# Categorías ML a analizar (separadas por coma)
# MLA1071=Celulares  MLA1051=Electrónica  MLA3937=Juguetes  MLA1039=Computación
# MLA1000=Electrodomésticos  MLA1648=Ropa  MLA1144=Deportes  MLA1499=Hogar
ML_ARBITRAGE_CATEGORIES=MLA1071,MLA1051,MLA3937

# Mínimo de ventas para considerar un producto
MIN_SOLD_QUANTITY=10

# Margen neto mínimo deseado (%)
MIN_MARGIN_PERCENT=20

# Multiplicador de costo de importación (incluye envío + aduana)
# 1.4 = +40% sobre el precio de Amazon
IMPORT_COST_FACTOR=1.4

# ── Amazon PA API (opcional — gratis con cuenta Associates) ──
# Sin esto, el script igual funciona y muestra links para revisar manualmente
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=tu-tag-20
