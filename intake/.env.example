# Postgres. Pegar aca la cadena de conexion de Supabase:
#   Project Settings > Database > Connection string > URI
# Reemplazar [YOUR-PASSWORD] por la contrasena del proyecto.
#
#   Session pooler  (puerto 5432) -> para desarrollo local
#   Transaction pooler (puerto 6543) -> para Vercel; la app le pone prepare:false sola
#
# Con Docker en vez de Supabase, dejar esta linea como esta y correr `npm run docker:up`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/intake

# URL publica de la app, usada para armar el snippet de embed
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend: si no esta seteada, los mails de recuperacion se loguean en consola
RESEND_API_KEY=
RESEND_FROM="Estudio <consultas@tudominio.com>"

# Protege /api/cron/recover
CRON_SECRET=dev-secret

# Login con Google (opcional: sin esto solo funciona email + contraseña).
# Origen autorizado: NEXT_PUBLIC_APP_URL
# Redirect URI: NEXT_PUBLIC_APP_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cuentas que crea el seed
SEED_STAFF_EMAIL=hola@clickderecho.com
SEED_PASSWORD=clickderecho2026
